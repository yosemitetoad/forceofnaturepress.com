---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getUpcomingEvents, getPastEvents } from '../lib/db';
import { mdInline } from '../lib/markdown';

const db = Astro.locals.runtime.env.DB;
const [upcomingRaw, pastRaw] = await Promise.all([getUpcomingEvents(db), getPastEvents(db)]);

const renderEvents = async (evts: typeof upcomingRaw) =>
  Promise.all(evts.map(async e => ({ ...e, descHtml: e.description ? await mdInline(e.description) : '' })));

const [upcoming, past] = await Promise.all([renderEvents(upcomingRaw), renderEvents(pastRaw)]);

const VENUE_LABEL: Record<string, string> = { indoor: 'Indoors', outdoor: 'Outdoors', both: 'In & Outdoors' };
const ENTRY_LABEL: Record<string, string> = { free: 'Free Entry', paid: 'Paid Entry' };
---

<Base title="Events — Force of Nature Press" description="Upcoming and past events for Force of Nature Press." fullWidth>

  <div class="events-header">
    <div class="container">
      <h1>Events</h1>
      <p>Find Force of Nature Press at markets, fairs, and festivals. Check back for updates on where we'll be next!</p>
    </div>
  </div>

  <div class="container events-body">

    <section class="events-section">
      <h2>Upcoming Events</h2>
      {upcoming.length === 0 ? (
        <p class="empty">No upcoming events scheduled yet — check back soon!</p>
      ) : (
        <ul class="event-list">
          {upcoming.map(e => (
            <li class="event-card">
              <div class="event-main">
                <div class="event-info">
                  {e.url
                    ? <a href={e.url} target="_blank" rel="noopener" class="event-name">{e.name}</a>
                    : <span class="event-name">{e.name}</span>
                  }
                  {e.dateLabel && <span class="event-date">{e.dateLabel}</span>}
                  {e.hours && <span class="event-hours">{e.hours}</span>}
                  {e.location && <span class="event-location">{e.location}</span>}
                </div>
                {(e.venueType || e.entryType) && (
                  <div class="event-tags">
                    {e.venueType && VENUE_LABEL[e.venueType] && <span class="event-tag">{VENUE_LABEL[e.venueType]}</span>}
                    {e.entryType && ENTRY_LABEL[e.entryType] && <span class={`event-tag entry-tag-${e.entryType}`}>{ENTRY_LABEL[e.entryType]}</span>}
                  </div>
                )}
              </div>
              {e.descHtml && <p class="event-description"><Fragment set:html={e.descHtml} /></p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    {past.length > 0 && (
      <section class="events-section past-section">
        <h2>Past Events</h2>
        <ul class="event-list">
          {past.map(e => (
            <li class="event-card past-card">
              <div class="event-main">
                <div class="event-info">
                  {e.url
                    ? <a href={e.url} target="_blank" rel="noopener" class="event-name">{e.name}</a>
                    : <span class="event-name">{e.name}</span>
                  }
                  {e.dateLabel && <span class="event-date">{e.dateLabel}</span>}
                  {e.hours && <span class="event-hours">{e.hours}</span>}
                  {e.location && <span class="event-location">{e.location}</span>}
                </div>
                {(e.venueType || e.entryType) && (
                  <div class="event-tags">
                    {e.venueType && VENUE_LABEL[e.venueType] && <span class="event-tag">{VENUE_LABEL[e.venueType]}</span>}
                    {e.entryType && ENTRY_LABEL[e.entryType] && <span class={`event-tag entry-tag-${e.entryType}`}>{ENTRY_LABEL[e.entryType]}</span>}
                  </div>
                )}
              </div>
              {e.descHtml && <p class="event-description"><Fragment set:html={e.descHtml} /></p>}
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>

</Base>

<style>
  .events-header {
    background: url('/plainstarbanner.webp') center / cover no-repeat;
    border-bottom: 2px solid var(--border);
    padding: 2.5rem 0 1.5rem;
    position: relative;
  }
  .events-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(250, 245, 234, 0.75);
  }
  .events-header .container { position: relative; }
  .events-header h1 { margin-bottom: 0.3em; }
  .events-header p { color: var(--brown-mid); margin: 0; }

  .events-body {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    max-width: 720px;
  }

  .events-section { margin-bottom: 2.5rem; }
  .past-section { opacity: 0.72; }

  h2 {
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--brown-mid);
    margin: 0 0 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }

  .empty {
    color: var(--brown-mid);
    font-size: 0.95rem;
    font-style: italic;
    margin: 0;
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .event-card {
    background: var(--cream-light);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1.2rem;
    transition: border-color 0.15s;
  }
  .event-card:has(a.event-name):hover { border-color: var(--orange); }

  .event-main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .event-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .event-name {
    font-weight: 800;
    font-size: 1rem;
    color: var(--brown);
    text-decoration: none;
  }
  a.event-name:hover { color: var(--orange); text-decoration: underline; }

  .event-date {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--orange);
  }

  .event-hours {
    font-size: 0.85rem;
    color: var(--brown-mid);
  }

  .event-location {
    font-size: 0.85rem;
    color: var(--brown-mid);
  }

  .event-tags {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
    flex-wrap: wrap;
    align-items: center;
  }

  .event-tag {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2em 0.6em;
    border-radius: 20px;
    background: var(--cream-dark);
    color: var(--brown-mid);
    border: 1px solid var(--border);
    white-space: nowrap;
  }

  .entry-tag-free { background: rgba(61, 122, 110, 0.12); color: var(--teal); border-color: var(--teal); }
  .entry-tag-paid { background: rgba(200, 120, 48, 0.1); color: var(--orange-dark); border-color: var(--orange); }

  .event-description {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    color: var(--brown-mid);
    line-height: 1.55;
  }
  .event-description :global(a) { color: var(--teal); text-decoration: underline; }
  .event-description :global(a:hover) { color: var(--teal-dark); }
  .event-description :global(strong) { color: var(--brown); }
</style>
