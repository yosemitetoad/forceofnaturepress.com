---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getUpcomingEvents, getPastEvents } from '../lib/db';

const db = Astro.locals.runtime.env.DB;
const [upcoming, past] = await Promise.all([getUpcomingEvents(db), getPastEvents(db)]);
---

<Base title="Events — Force of Nature Press" description="Upcoming and past events for Force of Nature Press." fullWidth>

  <div class="events-header">
    <div class="container">
      <h1>Events</h1>
      <p>Find Force of Nature Press at markets, fairs, and festivals. Check back for updates on where we'll be next!</p>
    </div>
  </div>

  <div class="container events-body">

    <section class="events-section">
      <h2>Upcoming Events</h2>
      {upcoming.length === 0 ? (
        <p class="empty">No upcoming events scheduled yet — check back soon!</p>
      ) : (
        <ul class="event-list">
          {upcoming.map(e => (
            <li class="event-card">
              <div class="event-info">
                {e.url
                  ? <a href={e.url} target="_blank" rel="noopener" class="event-name">{e.name}</a>
                  : <span class="event-name">{e.name}</span>
                }
                {e.dateLabel && <span class="event-date">{e.dateLabel}</span>}
                {e.location && <span class="event-location">{e.location}</span>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    {past.length > 0 && (
      <section class="events-section past-section">
        <h2>Past Events</h2>
        <ul class="event-list">
          {past.map(e => (
            <li class="event-card past-card">
              <div class="event-info">
                {e.url
                  ? <a href={e.url} target="_blank" rel="noopener" class="event-name">{e.name}</a>
                  : <span class="event-name">{e.name}</span>
                }
                {e.dateLabel && <span class="event-date">{e.dateLabel}</span>}
                {e.location && <span class="event-location">{e.location}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>

</Base>

<style>
  .events-header {
    background: url('/plainstarbanner.webp') center / cover no-repeat;
    border-bottom: 2px solid var(--border);
    padding: 2.5rem 0 1.5rem;
    position: relative;
  }
  .events-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(250, 245, 234, 0.75);
  }
  .events-header .container { position: relative; }
  .events-header h1 { margin-bottom: 0.3em; }
  .events-header p { color: var(--brown-mid); margin: 0; }

  .events-body {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    max-width: 720px;
  }

  .events-section { margin-bottom: 2.5rem; }

  h2 {
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--brown-mid);
    margin: 0 0 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }

  .empty {
    color: var(--brown-mid);
    font-size: 0.95rem;
    font-style: italic;
    margin: 0;
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .event-card {
    background: var(--cream-light);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1.2rem;
    transition: border-color 0.15s;
  }

  .event-card:has(a.event-name):hover {
    border-color: var(--orange);
  }

  .past-card { opacity: 0.65; }

  .event-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.8rem;
  }

  .event-name {
    font-weight: 800;
    font-size: 1rem;
    color: var(--brown);
    text-decoration: none;
  }

  a.event-name:hover {
    color: var(--orange);
    text-decoration: underline;
  }

  .event-date {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--orange);
  }

  .event-location {
    font-size: 0.85rem;
    color: var(--brown-mid);
  }
</style>
