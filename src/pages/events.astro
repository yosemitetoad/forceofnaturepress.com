---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getUpcomingEvents, getPastEvents } from '../lib/db';

const db = Astro.locals.runtime.env.DB;
const [upcoming, past] = await Promise.all([getUpcomingEvents(db), getPastEvents(db)]);
---

<Base title="Events — Force of Nature Press" description="Upcoming and past events for Force of Nature Press." fullWidth>
  <div class="events-wrap">
    <div class="container events-body">

      <div class="events-box">
        <h1>Events</h1>
        <p class="intro">Find Force of Nature Press at markets, fairs, and festivals. Check back for updates on where we'll be next!</p>
      </div>

      <div class="events-box">
        <h2>Upcoming Events</h2>
        {upcoming.length === 0 ? (
          <p class="empty">No upcoming events scheduled yet — check back soon!</p>
        ) : (
          <ul class="event-list">
            {upcoming.map(e => (
              <li class="event-card">
                <div class="event-info">
                  {e.url
                    ? <a href={e.url} target="_blank" rel="noopener" class="event-name">{e.name}</a>
                    : <span class="event-name">{e.name}</span>
                  }
                  {e.dateLabel && <span class="event-date">{e.dateLabel}</span>}
                  {e.location && <span class="event-location">{e.location}</span>}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>

      {past.length > 0 && (
        <div class="events-box past-box">
          <h2>Past Events</h2>
          <ul class="event-list">
            {past.map(e => (
              <li class="event-card">
                <div class="event-info">
                  {e.url
                    ? <a href={e.url} target="_blank" rel="noopener" class="event-name">{e.name}</a>
                    : <span class="event-name">{e.name}</span>
                  }
                  {e.dateLabel && <span class="event-date">{e.dateLabel}</span>}
                  {e.location && <span class="event-location">{e.location}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
  </div>
</Base>

<style>
  .events-wrap {
    background: url('/plainstarbanner.webp') center / cover no-repeat;
    min-height: calc(100vh - 72px - 120px);
    padding: 2.5rem 0 4rem;
    margin-bottom: -4rem;
  }

  .events-body {
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .events-box {
    background: rgba(240, 230, 208, 0.88);
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 2rem 2.2rem;
  }

  .past-box { opacity: 0.82; }

  h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--brown);
    margin: 0 0 0.5rem;
  }

  .intro {
    color: var(--brown-mid);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brown-mid);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }

  .empty {
    color: var(--brown-mid);
    font-size: 0.95rem;
    font-style: italic;
    margin: 0;
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .event-card {
    padding: 0.85rem 1rem;
    background: rgba(250, 245, 234, 0.7);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .event-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
  }

  .event-name {
    font-weight: 800;
    font-size: 1rem;
    color: var(--brown);
    text-decoration: none;
  }

  a.event-name:hover {
    color: var(--orange);
    text-decoration: underline;
  }

  .event-date {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--orange);
  }

  .event-location {
    font-size: 0.85rem;
    color: var(--brown-mid);
  }
</style>
