---
import { SITE_TITLE } from '../consts';

const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);
const infoActive = isActive('/about') || isActive('/events') || isActive('/media');
const shopActive = isActive('/shop') || isActive('/wholesale');
---

<header transition:persist>
  <div class="header-inner">
    <nav class="nav-left" aria-label="Main navigation left">
      <div class:list={['nav-dropdown', { active: shopActive }]}>
        <button class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Shop <span class="dropdown-arrow">▾</span>
        </button>
        <div class="dropdown-menu" role="menu">
          <a href="/shop" class:list={['dropdown-item', { active: isActive('/shop') }]} role="menuitem">Shop</a>
          <a href="/wholesale" class:list={['dropdown-item', { active: isActive('/wholesale') }]} role="menuitem">Wholesale</a>
        </div>
      </div>
      <a href="/portfolio" class:list={['nav-link', { active: isActive('/portfolio') }]}>Portfolio</a>
      <a href="/games" class:list={['nav-link', { active: isActive('/games') }]}>Games</a>
    </nav>

    <a href="/" class="logo-link" aria-label="Force of Nature Press home">
      <img src="/beetleshopsticker.webp" alt="" class="logo-img" />
    </a>

    <nav class="nav-right" aria-label="Main navigation right">
      <div class:list={['nav-dropdown', { active: infoActive }]}>
        <button class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Info <span class="dropdown-arrow">▾</span>
        </button>
        <div class="dropdown-menu" role="menu">
          <a href="/about" class:list={['dropdown-item', { active: isActive('/about') }]} role="menuitem">About</a>
          <a href="/events" class:list={['dropdown-item', { active: isActive('/events') }]} role="menuitem">Events</a>
          <a href="/media" class:list={['dropdown-item', { active: isActive('/media') }]} role="menuitem">Media</a>
        </div>
      </div>
      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Blog</a>
      <a href="/contact" class:list={['nav-link', { active: isActive('/contact') }]}>Contact</a>
    </nav>

    <button class="mobile-menu-btn" id="menuBtn" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobileNav" aria-hidden="true">
    <a href="/shop" class:list={['mobile-link', { active: isActive('/shop') }]}>Shop</a>
    <a href="/wholesale" class:list={['mobile-link', { active: isActive('/wholesale') }]}>Wholesale</a>
    <a href="/portfolio" class:list={['mobile-link', { active: isActive('/portfolio') }]}>Portfolio</a>
    <a href="/games" class:list={['mobile-link', { active: isActive('/games') }]}>Games</a>
    <a href="/about" class:list={['mobile-link', { active: isActive('/about') }]}>About</a>
    <a href="/events" class:list={['mobile-link', { active: isActive('/events') }]}>Events</a>
    <a href="/media" class:list={['mobile-link', { active: isActive('/media') }]}>Media</a>
    <a href="/blog" class:list={['mobile-link', { active: isActive('/blog') }]}>Blog</a>
    <a href="/contact" class:list={['mobile-link', { active: isActive('/contact') }]}>Contact</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    nav?.setAttribute('aria-hidden', String(!open));
  });

  // Update active nav link after View Transitions navigation
  function updateActiveNav() {
    const path = window.location.pathname;
    document.querySelectorAll('.nav-link, .mobile-link').forEach(link => {
      const href = link.getAttribute('href') || '';
      if (!href) return;
      const isActive = href === '/' ? path === '/' : path.startsWith(href);
      link.classList.toggle('active', isActive);
    });
    document.querySelectorAll('.nav-dropdown').forEach(dropdown => {
      const anyActive = Array.from(dropdown.querySelectorAll('.dropdown-item')).some(item => {
        const href = item.getAttribute('href') || '';
        return href && path.startsWith(href);
      });
      dropdown.classList.toggle('active', anyActive);
    });
  }
  document.addEventListener('astro:after-swap', updateActiveNav);
</script>

<style>
  header {
    background: var(--cream-light);
    border-bottom: 2px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 80px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .nav-left {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.2rem;
  }

  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.2rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-img {
    width: 60px;
    height: 60px;
    object-fit: contain;
    transition: transform 0.2s;
    color: transparent;
  }
  .logo-link:hover .logo-img {
    transform: scale(1.07);
  }

  .nav-link {
    padding: 0.4em 0.8em;
    color: var(--brown);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .nav-link:hover {
    background: var(--cream-dark);
    color: var(--brown);
  }
  .nav-link.active {
    color: var(--orange);
    background: rgba(200, 120, 48, 0.1);
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 6px;
    position: absolute;
    right: 1.5rem;
  }
  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--brown);
    border-radius: 2px;
    transition: 0.2s;
  }
  .mobile-menu-btn:hover { background: var(--cream-dark); }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 0.5rem 1.5rem 1rem;
    border-top: 1px solid var(--border);
    background: var(--cream-light);
  }
  .mobile-nav.open { display: flex; }

  .mobile-link {
    padding: 0.6em 0.5em;
    color: var(--brown);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
    border-radius: 6px;
  }
  .mobile-link:hover { background: var(--cream-dark); color: var(--brown); }
  .mobile-link.active { color: var(--orange); }

  /* Info dropdown */
  .nav-dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.25em;
    padding: 0.4em 0.8em;
    background: none;
    border: none;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--brown);
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .dropdown-trigger:hover,
  .nav-dropdown:hover .dropdown-trigger,
  .nav-dropdown:focus-within .dropdown-trigger {
    background: var(--cream-dark);
  }
  .nav-dropdown.active .dropdown-trigger {
    color: var(--orange);
    background: rgba(200, 120, 48, 0.1);
  }

  .dropdown-arrow {
    font-size: 0.72em;
    line-height: 1;
    margin-top: 1px;
    transition: transform 0.15s;
  }
  .nav-dropdown:hover .dropdown-arrow,
  .nav-dropdown:focus-within .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--cream-light);
    border: 2px solid var(--border);
    border-radius: 8px;
    padding: 0.3rem;
    min-width: 110px;
    box-shadow: 0 4px 14px var(--shadow);
    z-index: 200;
    flex-direction: column;
  }
  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    display: flex;
  }

  .dropdown-item {
    padding: 0.45em 0.8em;
    color: var(--brown);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 5px;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .dropdown-item:hover { background: var(--cream-dark); }
  .dropdown-item.active { color: var(--orange); }

  @media (max-width: 720px) {
    .nav-left, .nav-right { display: none; }
    .mobile-menu-btn { display: flex; }
    .header-inner {
      display: flex;
      justify-content: center;
      position: relative;
    }
  }
</style>
